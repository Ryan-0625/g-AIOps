CONFIG_PATH = Path.home() / ".gaiops" / "config"
DEFAULT_BASE_URL = "http://localhost:8080"

HARDCODED_ACTIONS = [
    "ping.icmp", "disk.usage", "dns.lookup", "http.get", "http.post",
    "system.info", "file.read", "file.write", "network.connections",
    "container.list", "service.status", "service.restart", "service.stop",
    "process.list", "process.kill", "exec.run", "log.tail",
    "tool.create", "tool.delete",
]

