    _arguments -C \\
        '--base-url[Master API URL]:url' \\
        '--token[Cluster token]:token' \\
        '--json[Raw JSON output]' \\
        '--help[Show help]' \\
        '--version[Show version]' \\
        '1: :->command' \\
        '*:: :->args'

    case $state in
        command)
            _gaiops_commands
            ;;
        args)
            case $words[1] in
                worker)
                    _arguments '2: :(list)'
                    ;;
                trace)
                    _arguments '2: :(list get)'
                    ;;
                config)
                    _arguments '2: :(init show)'
                    ;;
                execute)
                    _arguments \\
                        '--target-worker[Route to specific Worker]' \\
                        '--trace-id[Trace ID]' \\
                        '--priority[Priority 0-2]' \\
                        '--ttl[TTL seconds]' \\
                        '--wait[Wait for result]'
                    ;;
                result)
                    _arguments '--watch[Auto-refresh until done]'
                    ;;
                completion)
                    _arguments '2: :(bash zsh)'
                    ;;
            esac
            ;;
    esac
}

_gaiops "$@"
"""


# ── Parser ───────────────────────────────────────────────────────────────────


class GaiopsShell(cmd.Cmd):
    """Interactive gAIOps shell — type 'help' for commands, 'exit' to quit."""

    intro = ""
    prompt = _c("gaiops> ", C.CYAN) + " "

    def __init__(self, base_url, token, brain_url=None):
        super().__init__()
        self.base_url = base_url
        self.token = token
        self.brain_url = brain_url or DEFAULT_BRAIN_URL
        self.chat_history = []

    # ---- helpers ----
    def _fake(self, **kw):
        class FakeArgs:
            pass
        obj = FakeArgs()
        for k, v in kw.items():
            setattr(obj, k, v)
        return obj

    # ---- builtins ----
    def do_health(self, arg):
        """Show cluster health dashboard"""
        cmd_health(self._fake(base_url=self.base_url, token=self.token, json=False))

    def do_workers(self, arg):
        """List connected workers (same as 'worker list')"""
        result = request("GET", "/api/v1/workers", self.base_url, self.token)
        if self._check_auth(result):
            return
        cmd_worker_list(self._fake(base_url=self.base_url, token=self.token, json=False, _result=result))

    def do_status(self, arg):
        """Cluster status overview (health + workers + pending)"""
        cmd_status(self._fake(base_url=self.base_url, token=self.token, json=False))

    def do_exec(self, arg):
        """Execute a tool: exec <action> [key=val ...]"""
        if not arg:
            print(_err("Usage: exec <action> [key=val ...]"))
            return
        parts = arg.split()
        cmd_execute(self._fake(
            base_url=self.base_url, token=self.token, json=False,
            action=parts[0], params=parts[1:],
            target_worker=None, trace_id=None, priority=None, ttl=None, wait=False,
        ))

    def do_result(self, arg):
        """Get execution result: result <msg_id>"""
        if not arg:
            print(_err("Usage: result <msg_id>"))
            return
        cmd_result(self._fake(
            base_url=self.base_url, token=self.token, json=False,
            msg_id=arg.strip(), watch=False,
        ))

    def do_approve(self, arg):
        """Approve a pending operation: approve <id>"""
        if not arg:
            print(_err("Usage: approve <id>"))
            return
        cmd_approve(self._fake(
            base_url=self.base_url, token=self.token, json=False,
            approval_id=arg.strip(),
        ))

    def do_reject(self, arg):
        """Reject a pending operation: reject <id>"""
        if not arg:
            print(_err("Usage: reject <id>"))
            return
        cmd_reject(self._fake(
            base_url=self.base_url, token=self.token, json=False,
            approval_id=arg.strip(),
        ))

    def do_traces(self, arg):
        """List recent traces"""
        cmd_trace_list(self._fake(base_url=self.base_url, token=self.token, json=False))

    def do_trace(self, arg):
        """Get trace details: trace <trace_id>"""
        if not arg:
            print(_err("Usage: trace <trace_id>"))
            return
        cmd_trace_get(self._fake(
            base_url=self.base_url, token=self.token, json=False,
            trace_id=arg.strip(),
        ))

    def do_config(self, arg):
        """Show current configuration"""
        cmd_config_show(self._fake(base_url=self.base_url, token=self.token, json=False))

    # ---- enhanced help ----
    def do_help(self, arg):
        """Show help for commands or a specific command"""
        if arg:
            super().do_help(arg)
            return
        # Flat, clean help list.
        c = C.CYAN if _USE_COLOR else ""
        r = C.RESET if _USE_COLOR else ""
        d = C.DIM if _USE_COLOR else ""
        cmds = [
            ("health", "Check cluster health"),
            ("workers", "List connected workers"),
            ("status", "Cluster status overview"),
            ("traces", "List recent traces"),
            ("trace", "Get trace details"),
            ("exec", "Execute a tool action"),
            ("result", "Get execution result"),
            ("approve", "Approve a pending approval"),
            ("reject", "Reject a pending approval"),
            ("chat", "Natural language chat with Brain AI"),
            ("history", "Show chat history"),
            ("token", "Set or show cluster token"),
            ("config", "Show configuration"),
            ("exit", "Exit the shell"),
        ]
        for name, desc in cmds:
            print(f"  {c}{name:<12}{r} {d}{desc}{r}")
        print(f"\n  {d}Type 'help <command>' for details.{r}")

    # ---- chat ----
    def do_chat(self, arg):
        """Enter natural language chat mode with Brain AI"""
        _cmd_chat_loop(self.base_url, self.token, self.brain_url, self.chat_history)

    def do_history(self, arg):
        """Show chat history from current session"""
        count = len(self.chat_history)
        if not count:
            print(f"  {_dim('No messages yet.')}")
            return
        print(f"  {_info('History')}  {_dim(f'({count} msgs)')}")
        for entry in self.chat_history:
            role = entry["role"]
            msg = str(entry.get("message", ""))
            t = entry.get("time", "")
            time_str = f" [{t}]" if t else ""
            if role == "user":
                print(f"    {_bold('You')}{_dim(time_str)}  {msg[:150]}")
            else:
                brain_msg = msg[:200]
                if entry.get("summary"):
                    brain_msg += _dim(" ...")
                print(f"    {_info('Brain')}{_dim(time_str)}  {brain_msg}")

    # ---- auth ----
    def do_token(self, arg):
        """Show or set the cluster token: token [value]"""
        if arg:
            self.token = arg.strip()
            print(f"  {_ok('Token updated.')}")
        elif self.token:
            masked = self.token[:4] + "****" if len(self.token) > 4 else "****"
            print(f"  Token: {_dim(masked)}")
        else:
            print(f"  {_warn('No token set. Use: token <value>')}")

    def _check_auth(self, result: dict) -> bool:
        """Check if result is AUTH_FAILED and print help. Returns True if auth failed."""
        err = result.get("error", {})
        if isinstance(err, dict) and err.get("code") == "AUTH_FAILED":
            print(f"  {_err('认证失败，请设置集群令牌:')}")
            print(f"    {_dim('token <your-token>')}")
            print(f"    {_dim('或启动时: python cli/gaiops shell --token <token>')}")
            return True
        return False

    # ---- built-in overrides ----
    def do_exit(self, arg):
        """Exit the shell"""
        print(_dim("Goodbye."))
        return True

    def do_quit(self, arg):
        """Exit the shell"""
        return self.do_exit(arg)

    def emptyline(self):
        pass

    # ---- tab completion ----
    def complete_exec(self, text, line, begidx, endidx):
        actions = _fetch_actions(self.base_url, self.token)
        return [a for a in actions if a.startswith(text)]

    def completenamespace(self, text, *args):
        """Catch-all for Ctrl-D / EOF."""
        return []


def cmd_shell(args):
    """Enter interactive REPL mode."""
    if sys.stdout.isatty():
        os.system("cls" if os.name == "nt" else "clear")
    banner = _render_logo()
    print(banner)
    print(_box_top("Shell", C.CYAN, _fmt_timestamp()))
    print(_box_line(_dim("Interactive mode - type help for commands, exit to quit."), indent=2))
    print(_box_bottom())
    print()
    try:
        GaiopsShell(args.base_url, args.token, getattr(args, 'brain_url', DEFAULT_BRAIN_URL)).cmdloop()
    except AttributeError as e:
        # Workaround Python 3.13 readline.backend issue on Windows.
        if "readline" in str(e).lower():
            _patch_readline()
            GaiopsShell(args.base_url, args.token, getattr(args, 'brain_url', DEFAULT_BRAIN_URL)).cmdloop()
        else:
            raise


def _patch_readline():
    """Monkey-patch readline for Python 3.13 compatibility on Windows."""
    import readline as rl
    if not hasattr(rl, "backend"):
        rl.backend = "windows" if os.name == "nt" else "generic"


def _humanize(text, lang="en"):
    """Replace raw/internal Brain messages with user-friendly text."""
    if not text:
        return text
    # Planner failure
    if "Planner could not create a valid plan" in text:
        if lang == "zh":
            return "抱歉，我无法处理这个问题。请尝试询问系统运维相关的问题。"
        return "Sorry, I couldn't process that request. Please ask about system operations."
    # Cycle detected
    if "Cycle detected" in text:
        if lang == "zh":
            return "检测到重复错误，已停止执行。请检查 Worker 状态后重试。"
        return "Recurring error detected. Execution stopped. Please check worker status."
    # Total retries exceeded
    if "Total retries" in text and "exceeded" in text:
        if lang == "zh":
            return "操作执行失败：重试次数已用完。请稍后重试或检查系统状态。"
        return "Operation failed: retries exhausted. Please try again later or check system status."
    # Non-retryable error
    if "Non-retryable error" in text:
        if lang == "zh":
            return "操作执行失败：遇到不可恢复的错误。"
        return "Operation failed: non-recoverable error encountered."
    # No worker available error
    if "No worker available" in text:
        if lang == "zh":
            return "没有可用的 Worker 节点来执行此操作。请检查 Worker 是否在运行。"
        return "No available worker to perform this action. Please check if workers are running."
    # Node / worker not found
    if any(p in text for p in ["worker not found", "node not found", "unknown worker", "unknown node", "no such worker", "no such node"]):
        if lang == "zh":
            return "未找到指定的节点，请检查节点 ID 是否正确。"
        return "Specified node not found. Please check the node ID."
    # Execution error
    if "Error executing" in text or "execution error" in text.lower():
        if lang == "zh":
            return "执行操作时出错。请检查 Worker 状态后重试。"
        return "Error executing the operation. Please check worker status and try again."
    # Plan executed with failures in summaries
    if text == "Plan executed." or text == "Plan executed" or text == "Session ended.":
        if lang == "zh":
            return "操作执行完成，但部分步骤可能未成功。"
        return "Operation completed, but some steps may have failed."
    # Filter out raw internal lines from multi-line responses
    lines = text.split("\n")
    clean = []
    for ln in lines:
        s = ln.strip()
        # Skip raw internal lines
        if s.startswith("Analysis:") or s.startswith("{") or s.startswith("}"):
            continue
        if s.startswith("FAIL:") or s.startswith("Plan:") or s.startswith("Step "):
            continue
        if "error=" in s and "→" in s:
            continue
        clean.append(ln)
    return "\n".join(clean).strip() or text


def _chat_sep():
    """Print a subtle separator between conversation turns."""
    print(f"\n  {_dim('─' * (_box_w() + 2))}")


def _cmd_chat_loop(base_url, token, brain_url, history_store=None):
    """Internal chat loop — clean conversation flow."""
    if history_store is None:
        history_store = []

    # ── Chat mode header ──────────────────────────────
    print(_box_top("Chat Mode", C.CYAN))
    print(_box_line(_dim("/exit  /workers  /history  /clear")))
    print(_box_bottom())
    print()

    while True:
        try:
            raw = input(f"  {_bold('>')} ")
        except (EOFError, KeyboardInterrupt):
            print()
            break

        text = raw.strip()
        if not text:
            continue

        # ── Slash commands ────────────────────────────
        if text.startswith("/"):
            cmd = text.lower()
            if cmd in ("/exit", "/quit", "/q"):
                break
            elif cmd == "/workers":
                _cmd_chat_show_workers(base_url, token)
                continue
            elif cmd == "/history":
                _cmd_chat_show_history(history_store)
                continue
            elif cmd == "/clear":
                history_store.clear()
                print(f"  {_dim('Chat history cleared.')}")
                continue
            elif cmd == "/help":
                print(f"  {_bold('/exit')}     {_dim('Exit chat mode')}")
                print(f"  {_bold('/workers')}  {_dim('Show connected workers')}")
                print(f"  {_bold('/history')}  {_dim('Show chat history')}")
                print(f"  {_bold('/clear')}    {_dim('Clear chat history')}")
                continue
            else:
                print(f"  {_warn(f'Unknown: {cmd}')}")
                print(f"  {_dim('Type /help for commands')}")
                continue

        # ── User message (prompt line already shows it) ──
        ts = _fmt_timestamp()
        lang = "zh" if re.search(r'[一-鿿]', text) else "en"

        # ── Detect missing node selection ────────────────────
        needs_node = (
            lang == "zh" and re.search(r'(节点|worker|服务|机器)', text)
            and not re.search(r'(node-\d+|worker-\d+|localhost|\d+\.\d+\.\d+\.\d+)', text)
            and not text.startswith("/")
        )
        if needs_node:
            wr = request("GET", "/api/v1/workers", base_url, token)
            workers = wr.get("workers", []) if wr.get("status_code", 0) < 400 else []
            if len(workers) > 1:
                print(f"\n  {_info('Brain')}  {_dim(f'[{_fmt_timestamp()}]')}")
                print(f"    {'你有多个节点，请指定要操作的节点:' if lang == 'zh' else 'Multiple nodes available, please specify:'}")
                for i, w in enumerate(workers, 1):
                    wid = w.get("worker_id", "?")
                    load = f"{w.get('current_load', 0)}/{w.get('max_concurrent', 1)}"
                    print(f"      {i}. {_c(wid, C.CYAN)}  {_dim(f'[{load}]')}")
                if lang == "zh":
                    print(f"    {'例如: 检查 node-1 上的服务'}")
                else:
                    print(f"    {'Example: check services on node-1'}")
                _chat_sep()
                continue

        # ── Send to Brain API ─────────────────────────
        try:
            result = request("POST", "/api/chat", brain_url, token, {
                "message": text,
            })
        except Exception as e:
            ts_err = _fmt_timestamp()
            print(f"\n  {_info('Brain')}  {_dim(f'[{ts_err}]')}")
            print(f"    {_err(f'Connection error: {e}')}")
            print(f"    {_dim('Check that Brain is running.')}")
            history_store.append({"role": "user", "message": text, "time": ts})
            history_store.append({"role": "brain", "message": f"[Error] {e}", "time": ts_err})
            _chat_sep()
            continue

        conclusion = result.get("conclusion", "No response.") if isinstance(result, dict) else "No response."
        summaries = result.get("summaries", []) if isinstance(result, dict) else []
        status = result.get("status", "") if isinstance(result, dict) else ""
        error = result.get("error", "") if isinstance(result, dict) else ""

        # ── Brain response ────────────────────────────
        ts_resp = _fmt_timestamp()
        print(f"\n  {_info('Brain')}  {_dim(f'[{ts_resp}]')}")

        if result.get("status_code", 0) and result["status_code"] >= 400:
            print(f"    {_err(_error_summary(result))}")
            history_store.append({"role": "user", "message": text, "time": ts})
            history_store.append({"role": "brain", "message": _error_summary(result), "time": ts_resp})
            _chat_sep()
            continue
        elif error:
            print(f"    {_err(str(error)[:200])}")
            history_store.append({"role": "user", "message": text, "time": ts})
            history_store.append({"role": "brain", "message": str(error), "time": ts_resp})
            _chat_sep()
            continue
        elif status == "running":
            print(f"    {_warn('Still processing...')}")
            history_store.append({"role": "user", "message": text, "time": ts})
            history_store.append({"role": "brain", "message": "Still processing...", "time": ts_resp})
            _chat_sep()
            continue
        elif result.get("fast_path"):
            _display_fast_path(result, lang)
        else:
            display = _humanize(str(conclusion)[:800], lang)
            for ln in display.split("\n"):
                print(f"    {ln}")

        # ── Store history ─────────────────────────────
        history_store.append({"role": "user", "message": text, "time": ts})
        history_store.append({"role": "brain", "message": conclusion, "summary": summaries, "time": ts_resp})

        _chat_sep()

    # ── Exit message ─────────────────────────────────
    print(f"  {_dim('Chat session ended.')}")


def _display_fast_path(result, lang="en"):
    """Render fast-path result lines — concise, no raw data dump."""
    rstatus = result.get("status", "")
    conclusion = _humanize(str(result.get("conclusion", "")), lang)

    if rstatus == "rejected":
        print(f"    {_warn(conclusion[:300])}")
    elif rstatus == "failed":
        print(f"    {_err(conclusion[:300])}")
    elif result.get("tool"):
        print(f"    {conclusion[:300]}")
    else:
        print(f"    {conclusion[:500]}")


def _cmd_chat_show_workers(base_url, token):
    """Show available workers (for /workers in chat mode)."""
    result = request("GET", "/api/v1/workers", base_url, token)
    err = result.get("error", {})
    if isinstance(err, dict) and err.get("code") == "AUTH_FAILED":
        print(f"  {_err('认证失败，请设置集群令牌') if '认证' not in str(err) else str(err)}")
        print(f"    {_dim('使用 token 命令设置令牌')}")
        return
    workers = result.get("workers", [])
    print(f"  {_info('Workers')}")
    if not workers:
        print(f"    {_warn('No workers connected.')}")
        print(f"    {_dim('Start: docker compose up -d worker')}")
    else:
        for w in workers:
            wid = w.get("worker_id", "?")
            load = f"{w.get('current_load', 0)}/{w.get('max_concurrent', 1)}"
            print(f"    {_c(wid, C.CYAN)}  {_dim(f'[{load}]')}")


