#!/usr/bin/env python3
"""gAIOps CLI — interact with gAIOps Master from the terminal.

Usage:
  gaiops health
  gaiops worker list
  gaiops execute <action> [--key value ...]
  gaiops result <msg_id>
  gaiops approve <id>
  gaiops reject <id>
  gaiops trace list
  gaiops trace get <trace_id>
  gaiops config init
  gaiops config show

Common options:
  --base-url URL     Master API base URL (default http://localhost:8080)
  --token TOKEN      Cluster token (or set CLUSTER_TOKEN env)
  --json             Raw JSON output (no formatting)
  --help             Show help for any command
"""

import argparse
import json
import os
import urllib.error
import urllib.request
import uuid
from configparser import ConfigParser
from pathlib import Path

VERSION = "0.1.0"
CONFIG_PATH = Path.home() / ".gaiops" / "config"
DEFAULT_BASE_URL = "http://localhost:8080"


# ── Config ───────────────────────────────────────────────────────────────────


def load_config():
    cfg = ConfigParser()
    cfg["defaults"] = {
        "base_url": DEFAULT_BASE_URL,
        "token": "",
    }
    if CONFIG_PATH.exists():
        cfg.read(str(CONFIG_PATH))
    return cfg


def save_config(base_url: str, token: str):
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    cfg = ConfigParser()
    cfg["defaults"] = {"base_url": base_url, "token": token}
    with open(str(CONFIG_PATH), "w") as f:
        cfg.write(f)
    CONFIG_PATH.chmod(0o600)
    return cfg


# ── HTTP Client ──────────────────────────────────────────────────────────────


def request(method: str, path: str, base_url: str, token: str, body: dict | None = None) -> dict:
    url = f"{base_url.rstrip('/')}{path}"
    headers = {
        "User-Agent": f"gaiops-cli/{VERSION}",
        "Accept": "application/json",
    }
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    else:
        data = None

    try:
        req = urllib.request.Request(url, data=data, headers=headers, method=method)
        with urllib.request.urlopen(req, timeout=30) as resp:
            return {"status_code": resp.status, **json.loads(resp.read().decode("utf-8"))}
    except urllib.error.HTTPError as e:
        try:
            err_body = json.loads(e.read().decode("utf-8"))
        except Exception:
            err_body = {"error": {"code": "HTTP_ERROR", "message": str(e)}}
        return {"status_code": e.code, **err_body}
    except urllib.error.URLError as e:
        return {"status_code": 0, "error": {"code": "CONNECTION_ERROR", "message": str(e.reason)}}
    except Exception as e:
        return {"status_code": 0, "error": {"code": "UNEXPECTED_ERROR", "message": str(e)}}


# ── Output ───────────────────────────────────────────────────────────────────


def output(data, raw_json: bool = False):
    if raw_json:
        print(json.dumps(data, indent=2, ensure_ascii=False, default=str))
        return

    sc = data.get("status_code", 0)
    prefix = ""
    if sc and sc >= 400:
        prefix = "ERROR"
    elif sc and sc >= 200 and sc < 300:
        prefix = "OK"
    if prefix:
        print(f"[{prefix}] HTTP {sc}" if sc else f"[{prefix}]")

    # Print the rest, stripping internal fields.
    printable = {k: v for k, v in data.items() if k not in ("status_code",)}
    print(json.dumps(printable, indent=2, ensure_ascii=False, default=str))


def print_table(rows, headers, raw_json: bool = False):
    """Simple table output."""
    if raw_json:
        print(json.dumps(rows, indent=2, ensure_ascii=False, default=str))
        return

    col_widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            col_widths[i] = max(col_widths[i], len(str(cell)))

    sep = "  ".join(h.ljust(w) for h, w in zip(headers, col_widths))
    print(sep)
    print("-" * len(sep))
    for row in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(row, col_widths)))
    print(f"\nTotal: {len(rows)}")


# ── Commands ─────────────────────────────────────────────────────────────────


def cmd_health(args):
    """Check Master health."""
    result = request("GET", "/health", args.base_url, args.token)
    output(result, args.json)


def cmd_worker_list(args):
    """List connected Workers."""
    result = request("GET", "/api/v1/workers", args.base_url, args.token)
    if result.get("status_code", 0) >= 400:
        output(result, args.json)
        return
    workers = result.get("workers", [])
    if not workers:
        print("No workers connected.")
        return

    rows = []
    for w in workers:
        actions = ", ".join(w.get("actions", [])[:6])
        rows.append((
            w.get("worker_id", "?"),
            f"{w.get('current_load', '?')}/{w.get('max_concurrent', '?')}",
            w.get("worker_version", "?"),
            f"{w.get('uptime_seconds', 0)}s",
            actions,
        ))
    print_table(rows, ["WORKER ID", "LOAD", "VERSION", "UPTIME", "ACTIONS"], args.json)


def cmd_execute(args):
    """Execute a tool action."""
    # Collect params from key=value positional args.
    params = {}
    for kv in args.params:
        if "=" in kv:
            key, _, val = kv.partition("=")
            try:
                val = int(val)
            except ValueError:
                try:
                    val = float(val)
                except ValueError:
                    if val.lower() in ("true", "false"):
                        val = val.lower() == "true"
                    elif val == "null":
                        val = None
            params[key] = val
        else:
            params[kv] = True

    body = {
        "action": args.action,
        "params": params,
        "trace_id": args.trace_id or str(uuid.uuid4()),
    }
    if args.target_worker:
        body["target_worker_id"] = args.target_worker
    if args.priority is not None:
        body["priority"] = args.priority
    if args.ttl is not None:
        body["ttl_seconds"] = args.ttl

    result = request("POST", "/api/v1/execute", args.base_url, args.token, body)
    output(result, args.json)

    # If we got a msg_id, show the poll command.
    msg_id = result.get("msg_id", "")
    if msg_id:
        print(f"\nPoll result: gaiops result {msg_id}")


def cmd_result(args):
    """Get execution result by msg_id."""
    result = request("GET", f"/api/v1/result/{args.msg_id}", args.base_url, args.token)
    output(result, args.json)


def cmd_approve(args):
    """Approve a pending high-risk operation."""
    result = request("POST", f"/api/v1/approve/{args.approval_id}", args.base_url, args.token)
    output(result, args.json)


def cmd_reject(args):
    """Reject a pending high-risk operation."""
    result = request("POST", f"/api/v1/reject/{args.approval_id}", args.base_url, args.token)
    output(result, args.json)


def cmd_trace_list(args):
    """List recent traces."""
    result = request("GET", "/api/v1/traces", args.base_url, args.token)
    traces = result.get("traces", result.get("data", []))
    if isinstance(traces, list) and traces:
        rows = []
        for t in traces[:20]:
            rows.append((
                t.get("trace_id", "?")[:16],
                t.get("status", "?"),
                t.get("action", ""),
            ))
        print_table(rows, ["TRACE ID", "STATUS", "ACTION"], args.json)
    else:
        print(json.dumps(result, indent=2, ensure_ascii=False, default=str))


def cmd_trace_get(args):
    """Get trace details by trace_id."""
    result = request("GET", f"/api/v1/trace/{args.trace_id}", args.base_url, args.token)
    output(result, args.json)


def cmd_config_init(args):
    """Create a default config file."""
    base_url = args.base_url or input(f"Master URL [{DEFAULT_BASE_URL}]: ").strip() or DEFAULT_BASE_URL
    token = args.token or os.environ.get("CLUSTER_TOKEN", "") or input("Cluster token: ").strip()
    save_config(base_url, token)
    print(f"Config saved to {CONFIG_PATH}")
    print(f"  base_url = {base_url}")
    print(f"  token    = {'***' if token else '(empty)'}")


def cmd_config_show(args):
    """Show current config."""
    if not CONFIG_PATH.exists():
        print(f"No config file at {CONFIG_PATH}")
        print(f"Run 'gaiops config init' to create one.")
        return
    cfg = load_config()
    print(f"Config file: {CONFIG_PATH}")
    print(f"  base_url = {cfg.get('defaults', 'base_url', fallback=DEFAULT_BASE_URL)}")
    token = cfg.get("defaults", "token", fallback="")
    print(f"  token    = {'***' if token else '(empty)'}")
    print(f"\nEnvironment:")
    print(f"  CLUSTER_TOKEN = {'***' if os.environ.get('CLUSTER_TOKEN') else '(not set)'}")


# ── Main ─────────────────────────────────────────────────────────────────────


def build_parser():
    cfg = load_config()
    default_base_url = cfg.get("defaults", "base_url", fallback=DEFAULT_BASE_URL)
    env_token = os.environ.get("CLUSTER_TOKEN", "")

    parser = argparse.ArgumentParser(
        prog="gaiops",
        description="gAIOps CLI — interact with gAIOps Master",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument("--base-url", default=default_base_url, help="Master API URL")
    parser.add_argument("--token", default=env_token, help="Cluster token (or CLUSTER_TOKEN env)")
    parser.add_argument("--json", action="store_true", help="Raw JSON output")

    sub = parser.add_subparsers(dest="command", required=True)

    # health
    p = sub.add_parser("health", help="Check Master health")
    p.set_defaults(func=cmd_health)

    # worker
    pw = sub.add_parser("worker", help="Worker operations")
    pw_sub = pw.add_subparsers(dest="subcommand", required=True)
    pwl = pw_sub.add_parser("list", help="List connected Workers")
    pwl.set_defaults(func=cmd_worker_list)

    # execute
    pe = sub.add_parser("execute", help="Execute a tool action")
    pe.add_argument("action", help="Tool action name (e.g. ping.icmp)")
    pe.add_argument("params", nargs="*", help="Key-value pairs (e.g. target=8.8.8.8 count=3)")
    pe.add_argument("--target-worker", help="Route to a specific Worker")
    pe.add_argument("--trace-id", help="Trace ID (auto-generated if omitted)")
    pe.add_argument("--priority", type=int, choices=[0, 1, 2], help="Priority (0=low, 2=high)")
    pe.add_argument("--ttl", type=int, help="TTL in seconds (1-300)")
    pe.set_defaults(func=cmd_execute)

    # result
    pr = sub.add_parser("result", help="Get execution result by msg_id")
    pr.add_argument("msg_id", help="Message ID from execute response")
    pr.set_defaults(func=cmd_result)

    # approve
    pa = sub.add_parser("approve", help="Approve a high-risk operation")
    pa.add_argument("approval_id", help="Approval ID")
    pa.set_defaults(func=cmd_approve)

    # reject
    prj = sub.add_parser("reject", help="Reject a high-risk operation")
    prj.add_argument("approval_id", help="Approval ID")
    prj.set_defaults(func=cmd_reject)

    # trace
    pt = sub.add_parser("trace", help="Trace operations")
    pt_sub = pt.add_subparsers(dest="subcommand", required=True)
    ptl = pt_sub.add_parser("list", help="List recent traces")
    ptl.set_defaults(func=cmd_trace_list)
    ptg = pt_sub.add_parser("get", help="Get trace details")
    ptg.add_argument("trace_id", help="Trace ID")
    ptg.set_defaults(func=cmd_trace_get)

    # config
    pc = sub.add_parser("config", help="Configuration management")
    pc_sub = pc.add_subparsers(dest="subcommand", required=True)
    pci = pc_sub.add_parser("init", help="Create config file")
    pci.add_argument("--base-url", help="Master URL")
    pci.add_argument("--token", help="Cluster token")
    pci.set_defaults(func=cmd_config_init)
    pcs = pc_sub.add_parser("show", help="Show current config")
    pcs.set_defaults(func=cmd_config_show)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    # Inherit token from env if not set via --token.
    if not args.token and "CLUSTER_TOKEN" in os.environ:
        args.token = os.environ["CLUSTER_TOKEN"]

    args.func(args)


if __name__ == "__main__":
    main()
