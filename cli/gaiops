#!/usr/bin/env python3
"""gAIOps CLI — interact with gAIOps Master from the terminal.

Usage:
  gaiops health
  gaiops worker list
  gaiops execute <action> [key=val ...]
  gaiops result <msg_id>
  gaiops approve <id>
  gaiops reject <id>
  gaiops trace list
  gaiops trace get <trace_id>
  gaiops config init
  gaiops config show
  gaiops completion bash|zsh

Common options:
  --base-url URL     Master API base URL (default http://localhost:8080)
  --token TOKEN      Cluster token (or set CLUSTER_TOKEN env)
  --json             Raw JSON output (no formatting)
  --help             Show help for any command
"""

