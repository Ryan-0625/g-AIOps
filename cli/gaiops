            t = entry.get("time", "")
            time_str = f" [{t}]" if t else ""
            if role == "user":
                print(f"    {_bold('You')}{_dim(time_str)}  {msg[:150]}")
            else:
                brain_msg = msg[:200]
                if entry.get("summary"):
                    brain_msg += _dim(" ...")
                print(f"    {_info('Brain')}{_dim(time_str)}  {brain_msg}")


def cmd_chat(args):
    """Natural language chat with Brain AI."""
    if sys.stdout.isatty():
        os.system("cls" if os.name == "nt" else "clear")
    banner = _render_logo()
    print(banner)
    _cmd_chat_loop(args.base_url, args.token, args.brain_url)


def cmd_status(args):
    """Cluster status dashboard."""
    h = request("GET", "/health", args.base_url, args.token)
    w = request("GET", "/api/v1/workers", args.base_url, args.token)

    if args.json:
        print(json.dumps({"health": h, "workers": w}, indent=2, ensure_ascii=False, default=str))
        return

    h_sc = h.get("status_code", 0)
    h_status = h.get("status", "?")
    h_uptime = h.get("uptime", 0)
    w_list = w.get("workers", [])
    pending = h.get("orchestrator", {}).get("pending", 0)
    approvals = h.get("security", {}).get("pendingApprovals", 0)
    total_load = sum(x.get("current_load", 0) for x in w_list)
    total_max = sum(x.get("max_concurrent", 1) for x in w_list) or 1

    master_color = _ok if h_sc == 200 else _err
    print(f"  {_bold('=== Cluster Status ===')}")
    print(f"  {_bold('Master:')}   {master_color(h_status.upper())}  {_dim(f'(up {_fmt_uptime(h_uptime)})')}")
    print(f"  {_bold('Workers:')}  {len(w_list)} online  {_dim(f'({total_load}/{total_max} load)')}")
    print(f"  {_bold('Pending:')}  {pending}")
    print(f"  {_bold('Approvals:')} {approvals}")


def build_parser():
    cfg = load_config()
    default_base_url = cfg.get("defaults", "base_url", fallback=DEFAULT_BASE_URL)
    env_token = os.environ.get("CLUSTER_TOKEN", "")

    parser = argparse.ArgumentParser(
        prog="gaiops",
        description="gAIOps CLI — interact with gAIOps Master",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument("--base-url", default=default_base_url, help="Master API URL")
    parser.add_argument("--brain-url", default=os.environ.get("BRAIN_URL", DEFAULT_BRAIN_URL), help="Brain API URL (or BRAIN_URL env)")
    parser.add_argument("--token", default=env_token, help="Cluster token (or CLUSTER_TOKEN env)")
    parser.add_argument("--json", action="store_true", help="Raw JSON output")

    sub = parser.add_subparsers(dest="command")

    # health
    p = sub.add_parser("health", help="Check Master health")
    p.set_defaults(func=cmd_health)

    # worker
    pw = sub.add_parser("worker", help="Worker operations")
    pw_sub = pw.add_subparsers(dest="subcommand", required=True)
    pwl = pw_sub.add_parser("list", help="List connected Workers")
    pwl.set_defaults(func=cmd_worker_list)

    # execute
    pe = sub.add_parser("execute", help="Execute a tool action")
    pe.add_argument("action", help="Tool action name (e.g. ping.icmp)")
    pe.add_argument("params", nargs="*", help="Key=value pairs (e.g. target=8.8.8.8 count=3)")
    pe.add_argument("--target-worker", help="Route to a specific Worker")
    pe.add_argument("--trace-id", help="Trace ID (auto-generated if omitted)")
    pe.add_argument("--priority", type=int, choices=[0, 1, 2], help="Priority (0=low, 2=high)")
    pe.add_argument("--ttl", type=int, help="TTL in seconds (1-300)")
    pe.add_argument("--wait", "-w", action="store_true", help="Wait for result")
    # Try to inject available actions into help text.
    try:
        actions_list = _fetch_actions(default_base_url, env_token)
        if actions_list:
            pe.epilog = "Available actions:\n" + "\n".join(
                f"  {a}" for a in actions_list
            )
    except Exception:
        pass
    pe.set_defaults(func=cmd_execute)

    # result
    pr = sub.add_parser("result", help="Get execution result by msg_id")
    pr.add_argument("msg_id", help="Message ID from execute response")
    pr.add_argument("--watch", "-w", action="store_true", help="Auto-refresh until done")
    pr.set_defaults(func=cmd_result)

    # approve
    pa = sub.add_parser("approve", help="Approve a high-risk operation")
    pa.add_argument("approval_id", help="Approval ID")
    pa.set_defaults(func=cmd_approve)

    # reject
    prj = sub.add_parser("reject", help="Reject a high-risk operation")
    prj.add_argument("approval_id", help="Approval ID")
    prj.set_defaults(func=cmd_reject)

    # trace
    pt = sub.add_parser("trace", help="Trace operations")
    pt_sub = pt.add_subparsers(dest="subcommand", required=True)
    ptl = pt_sub.add_parser("list", help="List recent traces")
    ptl.set_defaults(func=cmd_trace_list)
    ptg = pt_sub.add_parser("get", help="Get trace details")
    ptg.add_argument("trace_id", help="Trace ID")
    ptg.set_defaults(func=cmd_trace_get)

    # config
    pc = sub.add_parser("config", help="Configuration management")
    pc_sub = pc.add_subparsers(dest="subcommand", required=True)
    pci = pc_sub.add_parser("init", help="Create config file")
    pci.add_argument("--base-url", help="Master URL")
    pci.add_argument("--token", help="Cluster token")
    pci.set_defaults(func=cmd_config_init)
    pcs = pc_sub.add_parser("show", help="Show current config")
    pcs.set_defaults(func=cmd_config_show)

    # status
    pst = sub.add_parser("status", help="Cluster status dashboard")
    pst.set_defaults(func=cmd_status)

    # shell
    psh = sub.add_parser("shell", help="Enter interactive REPL mode")
    psh.set_defaults(func=cmd_shell)

    # chat
    pchat = sub.add_parser("chat", help="Natural language chat with Brain AI")
    pchat.set_defaults(func=cmd_chat)

    # completion
    pcomp = sub.add_parser("completion", help="Generate shell completion script")
    pcomp.add_argument("shell", choices=["bash", "zsh"], help="Shell type")
    pcomp.set_defaults(func=cmd_completion)

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    if not args.token and "CLUSTER_TOKEN" in os.environ:
        args.token = os.environ["CLUSTER_TOKEN"]

    if not args.command:
        print(_render_logo())
        if _USE_COLOR:
            print(SHORT_HELP.format(c=C.CYAN, r=C.RESET, dim=C.DIM))
        else:
            print(SHORT_HELP.format(c="", r="", dim=""))
        return

    args.func(args)


if __name__ == "__main__":
    main()
