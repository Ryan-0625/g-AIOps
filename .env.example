# gAIOps 生产环境配置参考
# 复制为 .env 并根据环境修改，切勿将 .env 提交到版本控制
#
# 必填项（启动前必须设置）：
#   OPENAI_API_KEY     — LLM API 密钥（如果使用 OpenAI/DeepSeek）
#   CLUSTER_TOKEN      — 集群安全令牌，所有服务间通信使用

# === LLM 配置 ===
# 二选一：OpenAI 兼容 API（生产推荐）
# OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash
#
# 或 Ollama（本地部署）
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
LLM_PROVIDER=openai

# === Master 服务 ===
MASTER_API_URL=http://master:8080

# === 集群安全 ===
# 必填：所有服务间通信的共享认证令牌
CLUSTER_TOKEN=dev-token-change-in-production

# === TLS (可选) ===
# TLS_CERT_PATH=/etc/gaiops/certs/server.pem
# TLS_KEY_PATH=/etc/gaiops/certs/server-key.pem

# === Worker ===
WORKER_ID=e2e-worker-1
MASTER_URL=ws://master:8080

# === 日志 ===
LOG_LEVEL=info
AUDIT_LOG_PATH=/var/log/gaiops/audit.log
AUDIT_ENABLED=true

# === 容器资源限制 ===
# DOCKER_CPU_LIMIT=1
# DOCKER_MEM_LIMIT=512m
