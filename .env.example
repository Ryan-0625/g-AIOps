# gAIOps 开发环境配置
# 复制为 .env 并根据本地环境修改

# === Ollama (Brain LLM) ===
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# === Master 服务 ===
MASTER_WS_URL=ws://localhost:8080/ws
MASTER_API_URL=http://localhost:8080/api/v1

# === 集群安全 ===
CLUSTER_TOKEN=dev-token-change-in-production

# === Worker ===
WORKER_ID=dev-worker-1

# === 日志 ===
LOG_LEVEL=debug
LOG_DIR=/tmp/gaiops/logs
